{
  "name": "sealdice-logs-mcp",
  "version": "1.0.0",
  "description": "Read-only SealDice TRPG logs MCP server with IC/OOC filtering, cursor/time slicing, scoped access links, and web viewer",
  "type": "module",
  "bin": {
    "sealdice-logs-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/streamable-http-server.js",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "sealdice",
    "trpg",
    "logs",
    "coc",
    "dnd"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
